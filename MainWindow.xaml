<Window x:Class="AtmosProfile.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:local="using:AtmosProfile" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dolby Access PHRTF Enabler">
 <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TabView IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent">
 <TabViewItem Header="Dolby PHRTF" IsClosable="False">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="Form" Padding="24" Spacing="16" Loaded="Loaded">
   <TextBlock Text="Dolby Access PHRTF Enabler" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
   <ComboBox x:Name="Devices" Header="Playback device" HorizontalAlignment="Stretch" SelectionChanged="DeviceChanged" AutomationProperties.AutomationId="DeviceSelector"/>
   <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="ProfilePath" Header="Personalized headphone profile" PlaceholderText="Select or paste a file path" LostFocus="PathChanged" KeyDown="PathKeyDown" AutomationProperties.AutomationId="ProfilePath"/>
    <Button x:Name="Browse" Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseClicked" AutomationProperties.AutomationId="BrowseProfile"/>
   </Grid>
   <TextBlock x:Name="Metadata" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="ProfileMetadata"/>
   <TextBlock x:Name="AtmosStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="AtmosStatus"/>
   <Button x:Name="EnableAtmos" Content="Enable Atmos" Click="EnableAtmosClicked" Visibility="Collapsed" AutomationProperties.AutomationId="EnableAtmos"/>
   <ToggleSwitch x:Name="Personalized" Header="Personalized profile" OnContent="On" OffContent="Off" IsEnabled="False" Toggled="Toggled" AutomationProperties.AutomationId="PersonalizedToggle">
    <ToolTipService.ToolTip>On applies the selected profile. Off restores the saved device profile. Changing the file while On applies the new selection.</ToolTipService.ToolTip>
   </ToggleSwitch>
   <Button x:Name="Reset" Content="Reset configuration…" Click="ResetClicked" AutomationProperties.AutomationId="Reset"/>
<ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
   <InfoBar x:Name="Message" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="OperationStatus"><InfoBar.ActionButton><Button x:Name="Allow" Content="Allow anyway" Visibility="Collapsed" Click="AllowClicked"/></InfoBar.ActionButton></InfoBar>
  </StackPanel>
 </ScrollViewer>
 </TabViewItem>
 <TabViewItem Header="Dolby room" IsClosable="False"><local:RoomPage/></TabViewItem>
 <TabViewItem Header="DTS profile" IsClosable="False"><local:DtsPage/></TabViewItem>
 <TabViewItem Header="Headphone EQ" IsClosable="False"><local:HeadphoneEqPage/></TabViewItem>
 </TabView>
 <TextBlock Grid.Row="1" Margin="24,8,24,16" Text="Settings remain on this device after exit. Audio reinitialization or vendor profile changes may require reapplying." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="PersistenceDisclaimer"/>
 </Grid>
</Window>
