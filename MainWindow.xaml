<Window x:Class="AtmosProfile.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dolby Access PHRTF Enabler">
 <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="Form" Padding="24" Spacing="16" Loaded="Loaded">
   <TextBlock Text="Dolby Access PHRTF Enabler" Style="{ThemeResource TitleTextBlockStyle}"/>
   <ComboBox x:Name="Devices" Header="Playback device" HorizontalAlignment="Stretch" SelectionChanged="DeviceChanged" AutomationProperties.AutomationId="DeviceSelector"/>
   <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="ProfilePath" Header="Personalized headphone profile" IsReadOnly="True" PlaceholderText="Select a file" AutomationProperties.AutomationId="ProfilePath"/>
    <Button x:Name="Browse" Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseClicked" AutomationProperties.AutomationId="BrowseProfile"/>
   </Grid>
   <TextBlock x:Name="Metadata" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="ProfileMetadata"/>
   <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="AtmosStatus" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="AtmosStatus"/>
    <Button x:Name="Verify" Grid.Column="1" Content="Verify Atmos" Click="VerifyClicked" AutomationProperties.AutomationId="VerifyAtmos"/>
   </Grid>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ToggleSwitch x:Name="Personalized" Header="Personalized profile" OnContent="On" OffContent="Off" IsEnabled="False" Toggled="Toggled" AutomationProperties.AutomationId="PersonalizedToggle">
     <ToolTipService.ToolTip>Off restores the saved device profile. Dolby Atmos for Headphones stays enabled.</ToolTipService.ToolTip>
    </ToggleSwitch>
    <Button x:Name="Backup" Grid.Column="1" Content="Back up" VerticalAlignment="Center" Click="BackupClicked" IsEnabled="False" AutomationProperties.AutomationId="BackupProfile">
     <ToolTipService.ToolTip>A backup is also created automatically before each profile switch.</ToolTipService.ToolTip>
    </Button>
   </Grid>
   <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
   <InfoBar x:Name="Message" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="OperationStatus"/>
  </StackPanel>
 </ScrollViewer>
</Window>
